# HostelIQ AI - Environment Configuration

# Gemini API Key (Official Google GenAI SDK)
GEMINI_API_KEY=your_gemini_api_key_here

# MongoDB Database Configuration
MONGO_URI=mongodb://localhost:27017/hosteliq
MONGO_DB_NAME=hosteliq

# Application Settings
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://localhost:3002,http://127.0.0.1:3002
